# --- Site -------------------------------------------------------------
# Kanonische URL der Live-Seite (für Sitemap, Canonicals, OG-Tags).
SITE_URL=https://www.kim-marie-borger.de

# --- TinaCMS Cloud (https://app.tina.io) ------------------------------
# 1. Kostenloses Konto auf app.tina.io anlegen
# 2. Neues Projekt → GitHub-Repo verbinden
# 3. Client-ID + Read-Only-Token hier bzw. in Vercel eintragen
# Ohne diese Variablen baut die Seite im Local-Modus (Inhalte aus dem Repo,
# /admin deaktiviert).
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# --- Kontaktformular (https://resend.com) -----------------------------
# Ohne RESEND_API_KEY antwortet /api/contact mit 503 und das Formular zeigt
# einen Hinweis auf die direkte E-Mail-Adresse.
RESEND_API_KEY=
CONTACT_TO_EMAIL=kim-marie.borger@t-online.de
# Verifizierter Absender (Domain bei Resend verifizieren), sonst Fallback:
CONTACT_FROM_EMAIL=
