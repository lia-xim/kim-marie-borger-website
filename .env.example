# --- Site -------------------------------------------------------------
# Kanonische URL der Live-Seite (für Sitemap, Canonicals, OG-Tags).
SITE_URL=https://www.kim-marie-borger.de

# --- TinaCMS Cloud (https://app.tina.io) ------------------------------
# 1. Kostenloses Konto auf app.tina.io anlegen
# 2. Neues Projekt → GitHub-Repo verbinden
# 3. Client-ID + Read-Only-Token hier bzw. in Vercel eintragen
# Ohne diese Variablen baut die Seite im Local-Modus (Inhalte aus dem Repo,
# /admin deaktiviert).
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# --- Kontaktformular (https://resend.com) -----------------------------
# Ohne RESEND_API_KEY antwortet /api/contact mit 503 und das Formular zeigt
# einen Hinweis auf die direkte E-Mail-Adresse.
RESEND_API_KEY=
CONTACT_TO_EMAIL=kim-marie.borger@t-online.de
# Verifizierter Absender (Domain bei Resend verifizieren). Aktiviert auch
# die automatische Bestätigungs-E-Mail an die anfragende Person.
CONTACT_FROM_EMAIL=
# Optional: Antwortadresse fuer die Bestätigung, sonst CONTACT_TO_EMAIL.
CONTACT_REPLY_EMAIL=

# --- Kontakt-Outbox / Retry-Sicherheit -------------------------------
# Empfohlen fuer Produktion: Vercel KV oder Upstash Redis REST verbinden.
# Die Anfrage wird dann vor dem Resend-Versand zwischengespeichert und kann
# bei Transportfehlern ueber /api/contact-retry nachgesendet werden.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: eigene Outbox-Credentials statt Vercel-KV-Standardnamen.
CONTACT_OUTBOX_REST_URL=
CONTACT_OUTBOX_REST_TOKEN=
CONTACT_OUTBOX_PREFIX=kmb:contact
CONTACT_OUTBOX_RETENTION_DAYS=90
CONTACT_OUTBOX_BATCH_SIZE=10
# Betriebsalarm bei wiederholten Zustellfehlern.
CONTACT_ALERT_EMAIL=matthiasramahi@web.de
CONTACT_ALERT_AFTER_ATTEMPTS=2
# Vercel Cron sendet CRON_SECRET automatisch als Authorization: Bearer ...
CRON_SECRET=
# Optional fuer externe Scheduler statt Vercel Cron:
CONTACT_RETRY_SECRET=

# --- Umami Analytics --------------------------------------------------
# Client-Tracking ist im Layout fest verdrahtet; diese Variablen aktivieren
# zusaetzlich serverseitige Kontaktformular-Conversions aus /api/contact.
UMAMI_HOST_URL=https://analytics.contextter.com
UMAMI_WEBSITE_ID=374375a3-486e-4c83-97de-e05aa223c92d
UMAMI_HOSTNAME=www.kim-marie-borger.de
# Optional: User-Agent fuer serverseitige /api/send Events.
UMAMI_SERVER_USER_AGENT=KimMarieBorgerWebsite/1.0
