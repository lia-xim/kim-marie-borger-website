---
import {
	getLocalLocation,
	getLocalSeoPagesForLocation,
	getLocalSeoPagesForService,
	getLocalService,
	keywordLabel,
	localPagePath,
} from '../lib/local-seo';

interface Props {
	serviceSlug: string;
	currentLocationSlug?: string;
}

const { serviceSlug, currentLocationSlug } = Astro.props;
const service = getLocalService(serviceSlug);
const currentLocation = currentLocationSlug ? getLocalLocation(currentLocationSlug) : undefined;
const servicePages = service ? getLocalSeoPagesForService(service.slug) : [];
const siblingServicePages = currentLocation
	? getLocalSeoPagesForLocation(currentLocation.slug).filter((page) => page.service.slug !== serviceSlug)
	: [];
---

{service && servicePages.length > 0 && (
	<section class="section bg-paper2 local-seo-links" aria-labelledby={`local-links-${service.slug}`}>
		<div class="wrap">
			<div class="local-links-head reveal">
				<p class="eyebrow c">{service.linkHeading}</p>
				<h2 id={`local-links-${service.slug}`} class="display-m">
					{currentLocation
						? `Weitere lokale Seiten für ${service.parentLabel}`
						: `${service.parentLabel} in deiner Nähe`}
				</h2>
				<p class="lead">
					{currentLocation
						? `Alle Ortsseiten übernehmen Aufbau und Bildwelt dieser Leistung, sind aber textlich auf die jeweilige Stadt oder Region zugeschnitten.`
						: `Wähle deine Stadt oder Region und finde die passende Seite mit lokalen Informationen und direkter Anfrage.`}
				</p>
			</div>

			{currentLocation && siblingServicePages.length > 0 && (
				<div class="local-related reveal d1">
					<p class="ksmall">Weitere Leistungen {currentLocation.locative}</p>
					<div class="local-link-cloud local-link-cloud-compact">
						{siblingServicePages.map((page) => (
							<a href={localPagePath(page.service, page.location)}>
								{keywordLabel(page.service, page.location)}
							</a>
						))}
					</div>
				</div>
			)}

			<div class="local-link-cloud reveal d2">
				{servicePages.map((page) => {
					const active = currentLocationSlug === page.location.slug;
					return (
						<a
							href={localPagePath(page.service, page.location)}
							aria-current={active ? 'page' : undefined}
						>
							{keywordLabel(page.service, page.location)}
						</a>
					);
				})}
			</div>
		</div>
	</section>
)}
