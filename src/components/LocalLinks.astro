---
import {
	getContextLocalSeoPagesForService,
	getLocalLocation,
	getLocalService,
	getPrimaryLocalSeoPagesForService,
	getRelatedLocalSeoPagesForLocation,
	keywordLabel,
	localPagePath,
	serviceLocationsHubPath,
} from '../lib/local-seo';

interface Props {
	serviceSlug: string;
	currentLocationSlug?: string;
}

const { serviceSlug, currentLocationSlug } = Astro.props;
const service = getLocalService(serviceSlug);
const currentLocation = currentLocationSlug ? getLocalLocation(currentLocationSlug) : undefined;
const servicePages = service
	? currentLocation
		? getContextLocalSeoPagesForService(service.slug, currentLocation.slug)
		: getPrimaryLocalSeoPagesForService(service.slug)
	: [];
const siblingServicePages = currentLocation && service
	? getRelatedLocalSeoPagesForLocation(service.slug, currentLocation.slug)
	: [];
---

{service && servicePages.length > 0 && (
	<section class="section bg-paper2 local-seo-links" aria-labelledby={`local-links-${service.slug}`}>
		<div class="wrap">
			<div class="local-links-head reveal">
				<p class="eyebrow c">{service.linkHeading}</p>
				<h2 id={`local-links-${service.slug}`} class="display-m">
					{currentLocation
						? `Naechste Schritte ${currentLocation.locative}`
						: `${service.parentLabel}: wichtige Orte`}
				</h2>
				<p class="lead">
					{currentLocation
						? `Wenn der Anlass schon ortlich eingeordnet ist, fuehren diese Links zu verwandten Leistungen und nahe liegenden Ortsseiten.`
						: `Die wichtigsten lokalen Einstiege fuehren zuerst zu Duesseldorf, Koeln, Wuppertal und den naheliegenden Regionen.`}
				</p>
			</div>

			{currentLocation && siblingServicePages.length > 0 && (
				<div class="local-related reveal d1">
					<p class="ksmall">Verwandte Leistungen {currentLocation.locative}</p>
					<div class="local-link-cloud local-link-cloud-compact">
						{siblingServicePages.map((page) => (
							<a href={localPagePath(page.service, page.location)}>
								{keywordLabel(page.service, page.location)}
							</a>
						))}
					</div>
				</div>
			)}

			<div class="local-link-cloud reveal d2">
				{currentLocation && <p class="ksmall local-cloud-label">Weitere wichtige Orte fuer {service.parentLabel}</p>}
				{servicePages.map((page) => {
					const active = currentLocationSlug === page.location.slug;
					return (
						<a
							href={localPagePath(page.service, page.location)}
							aria-current={active ? 'page' : undefined}
						>
							{keywordLabel(page.service, page.location)}
						</a>
					);
				})}
				<a class="local-hub-link" href={serviceLocationsHubPath(service)}>
					Alle Orte fuer {service.keyword}
				</a>
			</div>
		</div>
	</section>
)}
