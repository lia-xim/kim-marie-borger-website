---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';
import { formatPhone, instagramHandle, instagramHref, normalizeHref, telHref, whatsappHref } from '../lib/url';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const brand = config?.brand ?? null;
const footer = config?.footer ?? null;
const contact = config?.contact ?? null;
const email = contact?.email ?? 'kim-marie.borger@t-online.de';
const phoneHref = telHref(contact?.phone);
const phoneLabel = formatPhone(contact?.phone);
const waHref = whatsappHref(contact?.whatsapp, 'Hallo Kim, ich habe eine Anfrage zu Live-Musik.');
const igHref = instagramHref(contact?.instagram ?? footer?.instagram);
const igHandle = instagramHandle(contact?.instagram ?? footer?.instagram);
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="wrap">
		<div class="footer-top">
			<div class="f-brand">
				<span class="name" data-tina-field={brand ? tinaField(brand, 'name') : undefined}>{brand?.name ?? 'Kim Marie Borger'}</span>
				<p data-tina-field={footer ? tinaField(footer, 'text') : undefined}>{footer?.text}</p>
				<p class="f-sign" data-tina-field={footer ? tinaField(footer, 'sign') : undefined}>{footer?.sign}</p>
			</div>
			<div><h4>Anlässe</h4><ul>
				<li><a href={normalizeHref('/hochzeiten')}>Hochzeit</a></li>
				<li><a href={normalizeHref('/beerdigungen')}>Beerdigung / Trauerfeier</a></li>
				<li><a href={normalizeHref('/geburtstage')}>Geburtstag</a></li>
				<li><a href={normalizeHref('/taufen')}>Taufe</a></li>
				<li><a href={normalizeHref('/konzerte')}>Konzert / Event</a></li>
				<li><a href={normalizeHref('/firmenfeiern')}>Firmenfeier</a></li>
				<li><a href={normalizeHref('/unterricht')}>Unterricht</a></li>
			</ul></div>
			<div><h4>Seiten</h4><ul>
				<li><a href="/">Start</a></li>
				<li><a href={normalizeHref('/leistungen')}>Leistungen</a></li>
				<li><a href={normalizeHref('/portfolio')}>Hörproben &amp; Referenzen</a></li>
				<li><a href={normalizeHref('/ueber-mich')}>Über mich</a></li>
				<li><a href={normalizeHref('/anfragen')}>Anfrage</a></li>
			</ul></div>
			<div><h4>Vor Ort</h4><ul>
				<li><a href={normalizeHref('/hochzeiten/duesseldorf')}>Hochzeitsmusik Düsseldorf</a></li>
				<li><a href={normalizeHref('/beerdigungen/wuppertal')}>Trauermusik Wuppertal</a></li>
				<li><a href={normalizeHref('/unterricht/koeln')}>Geigenunterricht Köln</a></li>
				<li><a href={normalizeHref('/firmenfeiern/duesseldorf')}>Firmenevent Musik Düsseldorf</a></li>
			</ul></div>
			<div><h4>Kontakt</h4><ul>
				<li><a href={`mailto:${email}`}>{email}</a></li>
				{waHref && <li><a href={waHref} rel="noopener" target="_blank" data-track-label="whatsapp-footer">WhatsApp · {phoneLabel}</a></li>}
					{phoneHref && <li><a href={phoneHref} data-track-label="phone-footer">{phoneLabel}</a></li>}
					{igHref && <li><a href={igHref} rel="noopener me" target="_blank" data-track-label="instagram-footer">Instagram {igHandle ?? ''}</a></li>}
				{footer?.youtube && <li><a href={footer.youtube} rel="noopener" target="_blank">YouTube</a></li>}
				{footer?.googleBusinessProfile && <li><a href={footer.googleBusinessProfile} rel="noopener" target="_blank">Google-Profil &amp; Bewertungen</a></li>}
			</ul></div>
		</div>
		<div class="footer-bottom">
			<span>© <span id="year">{year}</span> Kim Marie Borger · Viola</span>
			<span style="display:flex;gap:22px;">
				<a href={normalizeHref(footer?.impressum)}>Impressum</a>
				<a href={normalizeHref(footer?.datenschutz)}>Datenschutz</a>
				<a href={normalizeHref(footer?.agb ?? '/agb')}>AGB</a>
			</span>
		</div>
	</div>
</footer>
