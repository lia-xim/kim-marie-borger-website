---
// kmb.css ist das komplette Design-System der Originalseite (1:1 portiert).
import '../styles/kmb.css';
// Fonts werden self-hosted ausgeliefert (DSGVO) — Familiennamen identisch zur
// Google-Fonts-Einbindung der Originalseite, kmb.css greift unverändert.
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';

import { buildSrcset, isOptimizable, normalizeSrc, onVercel } from '../lib/img';
import { canonicalUrl } from '../lib/url';
// Kritische Schriftschnitte des Hero vorladen (Cormorant 400 + 300-italic für
// den Namen, Manrope 600 für die Überzeile) — verkürzt das LCP-Render-Delay.
import cormorant400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cormorant300it from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import manrope600 from '@fontsource/manrope/files/manrope-latin-600-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
}

const canonicalURL = canonicalUrl(Astro.site ?? new URL(Astro.url.origin), Astro.url.pathname);

const {
	title,
	description,
	image: rawImage = '/og-default.png',
	imageAlt = `${title} - Kim Marie Borger`,
	noindex = false,
} = Astro.props;
const image = normalizeSrc(rawImage) ?? rawImage;
const absoluteImage = new URL(image, canonicalURL);

// LCP: das Hero-Bild der Seite vorladen — mit demselben srcset wie im Markup,
// damit Preload und <img> exakt dieselbe Variante treffen.
const heroPreload = onVercel && isOptimizable(image) ? buildSrcset(image) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#F4EEE2" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap.xml" />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />

<link rel="preload" as="font" type="font/woff2" href={cormorant400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={cormorant300it} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={manrope600} crossorigin />

{heroPreload && (
	<link rel="preload" as="image" imagesrcset={heroPreload.srcset} imagesizes="100vw" fetchpriority="high" />
)}

<link rel="canonical" href={canonicalURL.href} />
<link rel="alternate" hreflang="de" href={canonicalURL.href} />
<link rel="alternate" hreflang="x-default" href={canonicalURL.href} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content="Kim Marie Borger · Viola" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage.href} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.href} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage.href} />
<meta name="twitter:image:alt" content={imageAlt} />
