---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
const cards = (data.cards ?? []).filter((c: unknown) => c !== null);
const titleLines: string[] = (data.title ?? '').split('\n');
const left = cards[0];
const right = cards[1];
---
<section class="section bg-olive solemn">
	<div class="wrap">
		<div class="solemn-head reveal">
			<svg class="fermata" viewBox="0 0 44 30" fill="none" aria-hidden="true">
				<path d="M2 26 C7 6, 37 6, 42 26" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
				<circle cx="22" cy="22" r="3" fill="currentColor"/>
			</svg>
			{data.eyebrow && <p class="eyebrow c light" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
			{data.title && <h2 class="display-m" data-tina-field={tinaField(data, 'title')}>
				{titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
			</h2>}
			{data.lead && <p class="lead" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
		</div>

		<div class="solemn-grid">
			{left && (
				<article class="solemn-card s-left reveal" data-tina-field={tinaField(left)}>
					{left.rom && <span class="rom">{left.rom}</span>}
					<h3>{left.title}</h3>
					<span class="rule" aria-hidden="true"></span>
					{left.poet && <p class="poet">{left.poet}</p>}
					{(left.list ?? []).filter(Boolean).length > 0 && (
						<ul class="rep-list">
							{(left.list ?? []).filter(Boolean).map((entry: string) => <li>{entry}</li>)}
						</ul>
					)}
					{left.linkLabel && <a class="link-line" href={left.href ?? '#'}>{left.linkLabel} <span class="ar">→</span></a>}
				</article>
			)}

			<div class="solemn-arch reveal d1">
				<div class="arch-in"><img src={data.image?.src} alt={data.image?.alt ?? ''} loading="lazy" decoding="async" data-tina-field={tinaField(data, 'image')}></div>
			</div>

			{right && (
				<article class="solemn-card reveal d2" data-tina-field={tinaField(right)}>
					{right.rom && <span class="rom">{right.rom}</span>}
					<h3>{right.title}</h3>
					<span class="rule" aria-hidden="true"></span>
					{right.poet && <p class="poet">{right.poet}</p>}
					{(right.list ?? []).filter(Boolean).length > 0 && (
						<ul class="rep-list">
							{(right.list ?? []).filter(Boolean).map((entry: string) => <li>{entry}</li>)}
						</ul>
					)}
					{right.linkLabel && <a class="link-line" href={right.href ?? '#'}>{right.linkLabel} <span class="ar">→</span></a>}
				</article>
			)}
		</div>
		{(data.list ?? []).filter(Boolean).length > 0 && (
			<div class="reveal" style="margin-top:clamp(34px,5vw,56px);text-align:center;">
				{data.listLabel && <p class="ksmall" style="color:var(--muted-dk);" data-tina-field={tinaField(data, 'listLabel')}>{data.listLabel}</p>}
				<div class="rep-list reveal d1" style="justify-content:center;" data-tina-field={tinaField(data, 'list')}>
					{(data.list ?? []).filter(Boolean).map((entry: string) => <span>{entry}</span>)}
				</div>
			</div>
		)}
	</div>
</section>
