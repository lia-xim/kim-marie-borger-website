---
import Img from '../Img.astro';
import { tinaFieldFrom } from '../../lib/tina-fields';

const { data } = Astro.props;
const titleLines: string[] = (data.title ?? '').split('\n');
---
<section class="hero hero-page">
	<div class="hero-photo"><Img src={data.image?.src} alt={data.image?.alt ?? ''} sizes="100vw" fetchpriority="high" decoding="async" data-tina-field={tinaFieldFrom(data, 'image')} /></div>
	<div class="hero-scrim" aria-hidden="true"></div>
	<div class="hero-mat" aria-hidden="true"></div>
	<div class="hero-content">
		<div class="hero-inner">
			{data.eyebrow && <p class="eyebrow ho ho-1" data-tina-field={tinaFieldFrom(data, 'eyebrow')}>{data.eyebrow}</p>}
			<h1 class="hp-title ho ho-2" data-tina-field={tinaFieldFrom(data, 'title')}>
				{titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
			</h1>
			{data.lead && <p class="hp-lead ho ho-2" data-tina-field={tinaFieldFrom(data, 'lead')}>{data.lead}</p>}
			{data.badge && <div class="ho ho-3"><span class="consult-badge" data-tina-field={tinaFieldFrom(data, 'badge')}><i aria-hidden="true"></i>{data.badge}</span></div>}
		</div>
	</div>
</section>
