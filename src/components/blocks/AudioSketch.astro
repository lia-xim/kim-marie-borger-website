---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';
import { normalizeSrc } from '../../lib/img';
import { normalizeHref } from '../../lib/url';

const { data, context = 'portfolio' } = Astro.props;
const tracks = (data.tracks ?? []).filter((t: unknown) => t !== null);
const first = tracks[0];
const firstTrack = first as any;
const hasReal = tracks.some((t: any) => t.src);
const realTrackCount = tracks.filter((t: any) => t?.src).length;
const pad2 = (n: number) => String(n).padStart(2, '0');
const firstArt = firstTrack?.art?.src ?? data.art?.src ?? '/uploads/mq0uz91j-viola-6668608_1280.webp';
const firstArtAlt = firstTrack?.art?.alt ?? data.art?.alt ?? '';
---
<section class={`section bg-paper2 audio-section audio-section-${context}`} data-audio-context={context}>
	<div class="wrap audio-split">
		<div class="reveal">
			{data.eyebrow && <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
			{data.title && <h2 class="display-m" style="margin:16px 0 18px;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
			{data.lead && <p class="lead" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
			{data.castLabel && <p class="ksmall" style="margin-top:26px;" data-tina-field={tinaField(data, 'castLabel')}>{data.castLabel}</p>}
			{data.castText && <p class="lead" style="margin-top:8px;" data-tina-field={tinaField(data, 'castText')}>{data.castText}</p>}
		</div>

		<div
			class="player reveal d1"
			id="player"
			data-track-player="portfolio_audio"
			data-track-count={tracks.length}
			data-track-real-count={realTrackCount}
		>
			<div class="player-now">
				<div class="player-art">
					<Img
						class="player-art-current"
						src={firstArt}
						alt={firstArtAlt}
						sizes="120px"
						loading="lazy"
						fetchpriority="low"
						data-tina-field={firstTrack?.art ? tinaField(firstTrack, 'art') : (data.art ? tinaField(data, 'art') : undefined)}
					/>
					<img class="player-art-next" alt="" aria-hidden="true" decoding="async" />
				</div>
				<div class="player-meta">
					<div class="pk" id="npKick">Jetzt ausgewählt</div>
					<div class="pt" id="npTitle">{first?.title ?? 'Hörprobe'}</div>
					<div class="pc" id="npComposer">{first?.composer ?? ''}</div>
				</div>
				<div class="player-ctrl">
					<button class="pbtn play" id="playBtn" aria-label="Abspielen" data-track-control="audio_toggle">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" id="playIcon"><path d="M8 5v14l11-7z"/></svg>
					</button>
				</div>
			</div>
			<div class="eq" id="eq" aria-hidden="true"></div>
			<div class="eq-time"><span id="eqLabel">{hasReal ? 'Aufnahme' : 'Klangskizze'}</span><span class="now" id="elapsed">0:00</span></div>
			<div class="playlist" id="playlist">
				{tracks.map((t: any, i: number) => (
					<button
						class={`track${i === 0 ? ' active' : ''}`}
						type="button"
						data-src={normalizeSrc(t.src) || undefined}
						data-index={i + 1}
						data-title={t.title}
						data-composer={t.composer ?? ''}
						data-dur={t.dur ?? ''}
						data-art={normalizeSrc(t.art?.src) || undefined}
						data-art-alt={t.art?.alt ?? ''}
						data-tina-field={tinaField(t)}
					>
						<span class="ti">{pad2(i + 1)}</span>
						<span><span class="tn">{t.title}</span><span class="tc" style="display:block">{t.composer}</span></span>
						<span class="tg">{t.tag}</span><span class="td">{t.dur}</span>
					</button>
				))}
			</div>
			{data.note && <div class="player-foot" data-tina-field={tinaField(data, 'note')}><span class="pip"></span>{data.note}</div>}
		</div>
		{context === 'home' && (
			<div class="audio-home-link reveal">
				<a href={normalizeHref('/portfolio')} class="link-line">Alle Hörproben &amp; Referenzen ansehen <span class="ar">&rarr;</span></a>
			</div>
		)}
	</div>
</section>
