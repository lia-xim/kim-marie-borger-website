---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';

const { data, context = 'page' } = Astro.props;
const tiles = (data.tiles ?? []).filter((t: unknown) => t !== null);
const url = data.url ?? '#';
---
<section class={`section social-follow social-follow-${context}`}>
	<div class="wrap">
		<div class="social-follow-stage reveal">
			<div class="social-follow-media">
				{tiles.map((tile: any) => (
					<div class="social-follow-photo" data-tina-field={tinaField(tile)}>
						<Img src={tile.image?.src} alt={tile.image?.alt ?? ''} sizes="(max-width: 700px) 50vw, 34vw" loading="lazy" decoding="async" />
					</div>
				))}
			</div>
			<div class="social-follow-card">
				{data.eyebrow && <p class="eyebrow c" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
				{data.title && <h2 class="display-m" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
				{data.lead && <p class="lead" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
				<div class="social-follow-actions">
					{data.handle && <a href={url} target="_blank" rel="noopener me" class="btn btn-solid" data-track-label={`instagram-follow-${context}`} data-tina-field={tinaField(data, 'handle')}>Auf Instagram folgen <span class="ar">→</span></a>}
					{data.googleProfileUrl && data.googleProfileLabel && <a href={data.googleProfileUrl} target="_blank" rel="noopener" class="social-follow-link" data-track-label={`google-reviews-${context}`} data-tina-field={tinaField(data, 'googleProfileLabel')}>{data.googleProfileLabel} <span class="ar">→</span></a>}
				</div>
				{data.handle && <p class="social-follow-handle">@{data.handle}</p>}
				{data.note && <p class="social-follow-note" data-tina-field={tinaField(data, 'note')}>{data.note}</p>}
			</div>
		</div>
	</div>
</section>
