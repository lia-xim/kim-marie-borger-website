---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';

const { data } = Astro.props;
---
<section class="section" id={data.anchorId || undefined}>
	<div class="wrap">
		<div class="reveal" style="margin-bottom:clamp(26px,3vw,42px);">
			{data.eyebrow && <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
			{data.title && <h2 class="display-m" style="margin-top:14px;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
		</div>
		<div class="video-grid reveal d1">
			<div class="video-frame" data-yt={data.youtubeId ?? ''} role="button" tabindex="0" aria-label="Video abspielen">
				<Img src={data.poster?.src} alt={data.poster?.alt ?? ''} sizes="(max-width: 1100px) 94vw, 980px" data-tina-field={tinaField(data, 'poster')} />
				<span class="play-ring"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
				{(data.capTitle || data.capText) && <span class="vcap" data-tina-field={tinaField(data, 'capText')}><b data-tina-field={tinaField(data, 'capTitle')}>{data.capTitle}</b>{data.capText}</span>}
			</div>
			<div class="video-side">
				{data.sideKicker && <p class="ksmall" data-tina-field={tinaField(data, 'sideKicker')}>{data.sideKicker}</p>}
				{data.sideTitle && <h3 class="display-s" data-tina-field={tinaField(data, 'sideTitle')}>{data.sideTitle}</h3>}
				{data.sideLead && <p class="lead" data-tina-field={tinaField(data, 'sideLead')}>{data.sideLead}</p>}
				{data.linkLabel && <a href={data.linkHref ?? '#kontakt'} class="link-line" data-tina-field={tinaField(data, 'linkLabel')}>{data.linkLabel} <span class="ar">→</span></a>}
			</div>
		</div>
	</div>
</section>
