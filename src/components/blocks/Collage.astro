---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';
import { normalizeHref } from '../../lib/url';

const { data } = Astro.props;
const items = (data.items ?? []).filter((i: unknown) => i !== null);
---
<section class="section" id={data.anchorId || undefined}>
	<div class="wrap">
		{(data.eyebrow || data.title || data.lead) && (
			<div class="reveal" style="text-align:center;max-width:45rem;margin-inline:auto;">
				{data.eyebrow && <p class="eyebrow c" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
				{data.title && <h2 class="display-l" style="margin-top:18px;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
				{data.lead && <p class="lead" style="margin:18px auto 0;text-align:center;" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
			</div>
		)}
		<div class="collage reveal d1">
			{items.map((item: any) => (
				<figure class="polaroid" data-tina-field={tinaField(item)}>
					<div class="pl-image"><Img src={item.image?.src} alt={item.image?.alt ?? ''} sizes="(max-width: 480px) 90vw, (max-width: 860px) 44vw, (max-width: 1600px) 28vw, 48rem" data-tina-field={tinaField(item, 'image')} /></div>
					<figcaption>
					{item.tag && <span class="pl-tag" data-tina-field={tinaField(item, 'tag')}>{item.tag}</span>}
					{item.label && <span class="pl-label" data-tina-field={tinaField(item, 'label')}>{item.label}</span>}
					</figcaption>
				</figure>
			))}
			{data.ribbon && <div class="ribbon" data-tina-field={tinaField(data, 'ribbon')}>{data.ribbon}</div>}
		</div>
		{data.footerLabel && (
			<div class="reveal" style="text-align:center;margin-top:clamp(28px,3.5vw,44px);"><a href={normalizeHref(data.footerHref)} class="link-line" data-tina-field={tinaField(data, 'footerLabel')}>{data.footerLabel} <span class="ar">→</span></a></div>
		)}
	</div>
</section>
