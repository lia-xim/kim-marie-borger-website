---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';

const { data } = Astro.props;
const items = (data.items ?? []).filter((i: unknown) => i !== null);
---
<section class="section" id={data.anchorId || undefined}>
	<div class="wrap">
		{(data.eyebrow || data.title || data.lead) && (
			<div class="reveal" style="text-align:center;max-width:720px;margin-inline:auto;">
				{data.eyebrow && <p class="eyebrow c" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
				{data.title && <h2 class="display-l" style="margin-top:18px;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
				{data.lead && <p class="lead" style="margin:18px auto 0;text-align:center;" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
			</div>
		)}
		<div class="collage reveal d1">
			{items.map((item: any, i: number) => (
				<figure class={`polaroid p${i + 1}`} data-tina-field={tinaField(item)}>
					<Img src={item.image?.src} alt={item.image?.alt ?? ''} sizes="(max-width: 700px) 72vw, 340px" />
					{item.tag && <span class="pl-tag">{item.tag}</span>}
					{item.label && <figcaption class="pl-label">{item.label}</figcaption>}
				</figure>
			))}
			{data.ribbon && <div class="ribbon" data-tina-field={tinaField(data, 'ribbon')}>{data.ribbon}</div>}
		</div>
		{data.footerLabel && (
			<div class="reveal" style="text-align:center;margin-top:clamp(28px,3.5vw,44px);"><a href={data.footerHref ?? '#'} class="link-line" data-tina-field={tinaField(data, 'footerLabel')}>{data.footerLabel} <span class="ar">→</span></a></div>
		)}
	</div>
</section>
