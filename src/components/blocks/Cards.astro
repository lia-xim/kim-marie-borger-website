---
import { tinaField } from '@tinacms/astro/tina-field';
import Img from '../Img.astro';
import { normalizeHref } from '../../lib/url';

const { data } = Astro.props;
const items = (data.items ?? []).filter((i: unknown) => i !== null);
const titleLines: string[] = (data.title ?? '').split('\n');
---
<section class="section" id={data.anchorId || undefined}>
	<div class="wrap">
		<div class="reveal" style="text-align:center;max-width:740px;margin-inline:auto;">
			{data.eyebrow && <p class="eyebrow c" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
			{data.title && <h2 class="display-l" style="margin-top:18px;" data-tina-field={tinaField(data, 'title')}>
				{titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
			</h2>}
			{data.lead && <p class="lead" style="margin:18px auto 0;text-align:center;" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
		</div>
		<div class="gal cols-4 reveal d1">
			{items.map((item: any) => item.image?.src ? (
				<a class="gal-card" href={normalizeHref(item.href)} data-tina-field={tinaField(item)}>
					<Img src={item.image.src} alt={item.image.alt ?? ''} sizes="(max-width: 1100px) 46vw, 23vw" loading="lazy" decoding="async" data-tina-field={tinaField(item, 'image')} />
					<span class="gc-body">
						<span class="gc-title" data-tina-field={tinaField(item, 'title')}>{item.title}</span>
						<span class="gc-poet" data-tina-field={tinaField(item, 'poet')}>{item.poet}</span>
						<span class="gc-link" data-tina-field={tinaField(item, 'linkLabel')}>{item.linkLabel ?? 'Zum Kapitel'} <span class="ar">→</span></span>
					</span>
				</a>
			) : (
				<a class="gal-card gc-plain" href={normalizeHref(item.href)} data-tina-field={tinaField(item)}>
					<span class="gc-body">
						<span class="gc-title" data-tina-field={tinaField(item, 'title')}>{item.title}</span>
						<span class="gc-rule" aria-hidden="true"></span>
						<span class="gc-poet" data-tina-field={tinaField(item, 'poet')}>{item.poet}</span>
						<span class="gc-link" data-tina-field={tinaField(item, 'linkLabel')}>{item.linkLabel ?? 'Zum Kapitel'} <span class="ar">→</span></span>
					</span>
				</a>
			))}
		</div>
		{data.footerLabel && (
			<div class="reveal" style="text-align:center;margin-top:clamp(28px,3.5vw,44px);"><a href={normalizeHref(data.footerHref)} class="link-line" data-tina-field={tinaField(data, 'footerLabel')}>{data.footerLabel} <span class="ar">→</span></a></div>
		)}
	</div>
</section>
