---
import { tinaFieldFrom } from '../../lib/tina-fields';

const { data } = Astro.props;
const items = (data.items ?? []).filter((i: unknown) => i !== null);
const titleLines: string[] = (data.title ?? '').split('\n');
const delays = ['', ' d1', ' d2'];
---
<section class="section bg-paper2">
	<div class="wrap">
		{data.eyebrow && <p class="eyebrow reveal" data-tina-field={tinaFieldFrom(data, 'eyebrow')}>{data.eyebrow}</p>}
		{data.title && <h2 class="display-m reveal" style="margin-top:14px;max-width:22ch;" data-tina-field={tinaFieldFrom(data, 'title')}>
			{titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
		</h2>}
		<div class="sched">
			{items.map((item: any, i: number) => (
				<div class={`sched-item reveal${delays[i % 3]}`} data-tina-field={tinaFieldFrom(item)}>
					{item.time && <span class="st" data-tina-field={tinaFieldFrom(item, 'time')}>{item.time}</span>}
					<h3 data-tina-field={tinaFieldFrom(item, 'title')}>{item.title}</h3>
					<p data-tina-field={tinaFieldFrom(item, 'text')}>{item.text}</p>
				</div>
			))}
		</div>
		{data.footnote && <p class="reveal" style="color:var(--muted-2);font-size:13px;margin-top:22px;" data-tina-field={tinaFieldFrom(data, 'footnote')}>{data.footnote}</p>}
	</div>
</section>
