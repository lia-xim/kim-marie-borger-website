		placeLabel: 'Kirche / Feierort',
		placePlaceholder: 'Kirche, Kapelle, Gemeindehaus oder private Feier',
		musicLabel: 'Liedideen',
		musicPlaceholder: 'Einzug, Tauflied, Segensmoment, Familienlied',
		musicHint: 'Vorhandene Stücke sind ohne Aufpreis möglich; besondere Liedwünsche klären wir vorher.',
		scopeLabel: 'Ablauf / Dauer',
