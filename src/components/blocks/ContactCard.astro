		submitLabel: 'Behutsam anfragen',
		dateLabel: 'Termin / Uhrzeit',
		datePlaceholder: 'z. B. Freitag, 11 Uhr oder noch in Klärung',
		placeLabel: 'Ort der Feier',
		placePlaceholder: 'Trauerhalle, Kirche, Friedhof oder Bestattungshaus',
		musicLabel: 'Wunschstücke',
		musicPlaceholder: 'z. B. Ave Maria, Amazing Grace, Lieblingslied',
		musicHint: 'Wenn Noten fehlen, klären wir den Aufwand vorher transparent.',
		scopeLabel: 'Ablauf / Dauer',
		scopePlaceholder: 'z. B. Trauerfeier, Gang zum Grab, 2-3 Stücke',
		messagePlaceholder: 'Wer koordiniert die Feier? Bestattungshaus, Redner:in, gewünschte Stücke oder Stimmung helfen sehr.',
