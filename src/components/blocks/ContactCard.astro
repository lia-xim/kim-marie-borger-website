const bgClass = data?.bg && data.bg !== 'none' ? ` bg-${data.bg}` : '';
const config = (await getConfig()).data?.config ?? null;
const contactOverride = (data?.contact ?? null) as ContactData | null;
const baseContact = (config?.contact ?? null) as ContactData | null;
const contact: ContactData | null = baseContact
	? {
			...baseContact,
			...contactOverride,
			checklist: contactOverride?.checklist?.length ? contactOverride.checklist : baseContact.checklist,
		}
	: contactOverride;
const checklist = (contact?.checklist ?? []).filter((c: unknown): c is string => typeof c === 'string' && c.trim() !== '');
const notes = (contact?.notes ?? []).filter((c: unknown): c is string => typeof c === 'string' && c.trim() !== '');
const defaultOccasion = typeof contact?.defaultOccasion === 'string' ? contact.defaultOccasion : '';
const sourceLabel = typeof contact?.sourceLabel === 'string' ? contact.sourceLabel : '';
const sourcePath = Astro.url.pathname;
const context = getFormContext(defaultOccasion, sourceLabel, sourcePath);
const selectedOccasion = defaultOccasion || context.occasion;
const sourceContext = sourceLabel || context.label;
const occasionOptions = ['Hochzeit', 'Trauerfeier', 'Taufe', 'Geburtstag', 'Firmenevent', 'Konzert / Kultur', 'Unterricht', 'Anderer Anlass'];

function getFormContext(defaultOccasion: string, sourceLabel: string, path: string): FormContext {
	const haystack = `${defaultOccasion} ${sourceLabel} ${path}`.toLowerCase();
	if (haystack.includes('hochzeit')) return formContexts.hochzeit;
	if (haystack.includes('trauer') || haystack.includes('beerdigung') || haystack.includes('abschied')) return formContexts.trauer;
	if (
		haystack.includes('unterricht')
		|| haystack.includes('geige-lernen')
		|| haystack.includes('geigenunterricht')
		|| haystack.includes('bratsche-lernen')
		|| haystack.includes('viola-lernen')
	) return formContexts.unterricht;
	if (haystack.includes('firma') || haystack.includes('firmen') || haystack.includes('business') || haystack.includes('messe') || haystack.includes('gala')) return formContexts.firmenevent;
	if (haystack.includes('geburtstag') || haystack.includes('private-feier')) return formContexts.geburtstag;
	if (haystack.includes('taufe') || haystack.includes('segnung') || haystack.includes('kommunion') || haystack.includes('konfirmation')) return formContexts.taufe;
	if (haystack.includes('konzert') || haystack.includes('kultur') || haystack.includes('vernissage') || haystack.includes('lesung')) return formContexts.konzert;
	return formContexts.generic;
}
---
<section class={`section${bgClass}`} id={data?.anchorId || 'kontakt'}>
	<div class="wrap">
		<div class="contact-card form-first">
			<aside class="contact-aside reveal">
				{contact?.asideImage && <Img class="c-bg" src={contact.asideImage} alt="" sizes="(max-width: 900px) 94vw, 42vw" aria-hidden="true" loading="lazy" />}
				{contact?.eyebrow && <p class="eyebrow" data-tina-field={contact ? tinaFieldFrom(contact, 'eyebrow') : undefined}>{contact.eyebrow}</p>}
				{contact?.title && <h2 class="display-s" style="margin:16px 0 14px;" data-tina-field={contact ? tinaFieldFrom(contact, 'title') : undefined}>{contact.title}</h2>}
				{contact?.lead && <p class="lead" data-tina-field={contact ? tinaFieldFrom(contact, 'lead') : undefined}>{contact.lead}</p>}
				{checklist.length > 0 && (
					<div class="checklist">
						{checklist.map((c: string, i: number) => <span data-tina-field={contact ? tinaFieldFrom(contact, 'checklist', i) : undefined}>{c}</span>)}
					</div>
				)}
				{notes.length > 0 && (
					<ul class="contact-notes">
						{notes.map((note: string, i: number) => <li data-tina-field={contact ? tinaFieldFrom(contact, 'notes', i) : undefined}>{note}</li>)}
					</ul>
				)}
				<div class="c-rows">
					<div class="c-row"><span class="ci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><div><div class="ck">E-Mail</div><a class="cv" href={`mailto:${contact?.email ?? ''}`}>{contact?.email}</a></div></div>
					<div class="c-row"><span class="ci"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span><div><div class="ck">Einsatzgebiet</div><span class="cv">{contact?.area}</span></div></div>
				</div>
			</aside>
			<div class="form-panel">
				<div class="fp-head reveal">
					{contact?.formEyebrow && <p class="eyebrow" data-tina-field={contact ? tinaFieldFrom(contact, 'formEyebrow') : undefined}>{contact.formEyebrow}</p>}
					{contact?.formTitle && <h3 class="display-s" style="margin-top:10px;" data-tina-field={contact ? tinaFieldFrom(contact, 'formTitle') : undefined}>{contact.formTitle}</h3>}
					<p class="form-context">{context.intro}</p>
				</div>
				<form class="reveal d1" id="anfrageForm" novalidate>
					<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0;" />
					<input type="hidden" name="seite" value={sourcePath} />
					<input type="hidden" name="seitenkontext" value={sourceContext} />
					<input type="hidden" name="formularvariante" value={context.label} />
					<div class="row-2">
						<div class="field"><label for="f-name">Name</label><input id="f-name" type="text" name="name" placeholder="Dein Name" required></div>
						<div class="field"><label for="f-mail">E-Mail</label><input id="f-mail" type="email" name="email" placeholder="dein@email.de" required></div>
					</div>
					<div class="row-3">
						<div class="field">
							<label for="f-anlass">Anlass <span class="opt">(optional)</span></label>
							<select id="f-anlass" name="anlass">
								<option value="" selected={!selectedOccasion}>Bitte wählen</option>
								{occasionOptions.map((option) => <option value={option} selected={option === selectedOccasion}>{option}</option>)}
							</select>
						</div>
						<div class="field"><label for="f-date">{context.dateLabel} <span class="opt">(optional)</span></label><input id="f-date" type="text" name="datum" placeholder={context.datePlaceholder}></div>
						<div class="field"><label for="f-place">{context.placeLabel} <span class="opt">(optional)</span></label><input id="f-place" type="text" name="ort" placeholder={context.placePlaceholder}></div>
					</div>
					<div class="row-2">
						<div class="field"><label for="f-music">{context.musicLabel} <span class="opt">(optional)</span></label><input id="f-music" type="text" name="wunschmusik" placeholder={context.musicPlaceholder}><p class="field-hint">{context.musicHint}</p></div>
						<div class="field"><label for="f-scope">{context.scopeLabel} <span class="opt">(optional)</span></label><input id="f-scope" type="text" name="umfang" placeholder={context.scopePlaceholder}></div>
					</div>
					<div class="field"><label for="f-msg">Nachricht <span class="opt">(optional)</span></label><textarea id="f-msg" name="nachricht" placeholder={context.messagePlaceholder}></textarea></div>
					<p class="form-note">{context.note}</p>
					<button type="submit" class="btn btn-solid" style="width:100%;justify-content:center;">{context.submitLabel} <span class="ar">→</span></button>
					<div class="form-ok" id="formOk" role="status" aria-live="polite" data-success={contact?.formSuccess ?? 'Vielen Dank — deine Anfrage ist eingegangen.'} data-tina-field={contact ? tinaFieldFrom(contact, 'formSuccess') : undefined}>{contact?.formSuccess ?? 'Vielen Dank — deine Anfrage ist eingegangen.'}</div>
				</form>
			</div>
		</div>
	</div>
</section>
