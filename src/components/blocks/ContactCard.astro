		placePlaceholder: 'Wohnort, online, bei mir oder noch offen',
		musicLabel: 'Ziel / Repertoire',
		musicPlaceholder: 'Anfänger:in, Wiedereinstieg, Geige lernen, Bratsche lernen, Vorspiel',
		musicHint: 'Auch hilfreich: Ist ein Instrument vorhanden oder wird Beratung dazu gebraucht?',
		scopeLabel: 'Format',
		scopePlaceholder: 'z. B. Einzelstunde, regelmäßig, Vorbereitung auf Vorspiel',
		messagePlaceholder: 'Erzähl kurz von Vorerfahrung, Alter, Instrument, Ziel und was dir beim Lernen wichtig ist.',
		note: 'Die erste Kontaktaufnahme ist kostenlos und unverbindlich. Unterrichtspreise und Rhythmus stimmen wir individuell ab.',
	},
	firmenevent: {
		key: 'firmenevent',
		label: 'Firmenevent / Business-Event',
		occasion: 'Firmenevent',
		intro: 'Für Business-Anfragen sind Anlass, Gästezahl, Zeitfenster und Rechnungsrahmen besonders hilfreich.',
		submitLabel: 'Firmenevent anfragen',
		dateLabel: 'Datum / Zeitfenster',
		datePlaceholder: 'z. B. 03.12.2026, Empfang 18-19 Uhr',
		placeLabel: 'Ort / Venue',
