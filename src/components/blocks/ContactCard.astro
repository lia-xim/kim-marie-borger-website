		submitLabel: 'Kulturformat anfragen',
		dateLabel: 'Datum / Zeitraum',
		datePlaceholder: 'z. B. Vernissage am 08.05.2026, 19 Uhr',
		placeLabel: 'Ort / Bühne',
		placePlaceholder: 'Galerie, Kirche, Saal, Bühne, Akustik oder Technik',
		musicLabel: 'Programmidee',
		musicPlaceholder: 'Klassik, moderne Stücke, Lesung, Vernissage',
		musicHint: 'Programm und Preisrahmen entstehen nach Dauer, Vorbereitung und Format.',
		scopeLabel: 'Umfang / Publikum',
		scopePlaceholder: 'z. B. 30 Min., 2 Sets, ca. 60 Personen',
		messagePlaceholder: 'Welche Atmosphäre soll entstehen? Gern mit Technik, Ablauf, Moderation und Programmlänge.',
		note: 'Die Anfrage ist kostenlos und unverbindlich. Preise vereinbaren wir individuell; vorhandenes Repertoire ist ohne Aufpreis möglich.',
	},
	generic: {
		key: 'generic',
		label: 'Allgemeine Anfrage',
		occasion: '',
		intro: 'Mit Anlass, Datum, Ort und gewünschtem Umfang kann ich Verfügbarkeit und Preisrahmen schneller einschätzen.',
		submitLabel: 'Anfrage senden',
		dateLabel: 'Datum / Zeitraum',
		datePlaceholder: 'z. B. 14.09.2026 oder noch offen',
		placeLabel: 'Ort / Location',
		placePlaceholder: 'Stadt, Location oder Raum',
		musicLabel: 'Wunschmusik / Stücke',
		musicPlaceholder: 'z. B. Ave Maria, Lieblingslied, noch offen',
		musicHint: 'Vorhandenes Repertoire ist ohne Aufpreis möglich; neue Stücke klären wir vorher.',
		scopeLabel: 'Umfang / Dauer',
