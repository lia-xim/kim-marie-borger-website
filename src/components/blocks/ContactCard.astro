---
import Img from '../Img.astro';
import { getConfig } from '../../lib/data';
import { tinaFieldFrom } from '../../lib/tina-fields';

const { data } = Astro.props;
type ContactData = Record<string, any> & { checklist?: unknown[] };
type ContextKey = 'hochzeit' | 'trauer' | 'unterricht' | 'firmenevent' | 'geburtstag' | 'taufe' | 'konzert' | 'generic';
type FormContext = {
	key: ContextKey;
	label: string;
	occasion: string;
	intro: string;
	submitLabel: string;
	dateLabel: string;
	datePlaceholder: string;
	placeLabel: string;
	placePlaceholder: string;
	musicLabel: string;
	musicPlaceholder: string;
	musicHint: string;
	scopeLabel: string;
	scopePlaceholder: string;
	messagePlaceholder: string;
	note: string;
};

const formContexts: Record<ContextKey, FormContext> = {
	hochzeit: {
		key: 'hochzeit',
		label: 'Hochzeitsmusik',
		occasion: 'Hochzeit',
		intro: 'Hilfreich sind Trauort, Zeitfenster und die Momente, die musikalisch begleitet werden sollen.',
		submitLabel: 'Hochzeit anfragen',
		dateLabel: 'Datum / Zeitfenster',
		datePlaceholder: 'z. B. 14.09.2026, Trauung um 15 Uhr',
		placeLabel: 'Ort / Location',
		placePlaceholder: 'Standesamt, Kirche, freie Trauung oder Location',
		musicLabel: 'Wunschmusik / Momente',
		musicPlaceholder: 'Einzug, Ringtausch, Auszug, Lieblingslied',
		musicHint: 'Vorhandenes Repertoire ist ohne Aufpreis möglich; neue Arrangements klären wir vorher.',
		scopeLabel: 'Umfang / Dauer',
