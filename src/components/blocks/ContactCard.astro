		musicLabel: 'Wirkung / Musikrichtung',
		musicPlaceholder: 'Elegant, dezent, festlich, Dinner, Produktlaunch',
		musicHint: 'Vorhandenes Repertoire ist ohne Aufpreis möglich; Sonderwünsche klären wir vorher.',
		scopeLabel: 'Umfang / Gäste',
		scopePlaceholder: 'z. B. 80 Gäste, Empfang 45 Min., Dinner 2 Sets',
		messagePlaceholder: 'Gern mit Anlass, Ziel der Musik, Ansprechperson, Technik und Rechnungsdaten.',
		note: 'Die Anfrage ist kostenlos und unverbindlich. Preise werden individuell nach Termin, Ort, Dauer, Vorbereitung, Technik und Anfahrt vereinbart.',
	},
	geburtstag: {
		key: 'geburtstag',
		label: 'Geburtstag / private Feier',
		occasion: 'Geburtstag',
		intro: 'Sag kurz, ob es um Überraschung, Empfang, Dinner oder einen besonderen Moment geht.',
		submitLabel: 'Feier anfragen',
		dateLabel: 'Datum / Zeitfenster',
		datePlaceholder: 'z. B. Samstagabend, Empfang ab 17 Uhr',
		placeLabel: 'Ort / Rahmen',
		placePlaceholder: 'Zuhause, Restaurant, Garten, Saal oder Stadt',
		musicLabel: 'Wunschmusik',
		musicPlaceholder: 'Lieblingslied, ruhige Stücke, festliche Musik',
		musicHint: 'Wenn ein persönliches Wunschstück neu notiert werden muss, klären wir das vorher.',
		scopeLabel: 'Umfang / Dauer',
