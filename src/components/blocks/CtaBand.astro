---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
---
<section class="section bg-olive" style="text-align:center;">
	<div class="wrap">
		{data.eyebrow && <p class="eyebrow c light reveal" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
		{data.title && <h2 class="display-m reveal d1" style="margin:16px auto 0;max-width:20ch;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
		{data.lead && <p class="lead reveal d1" style="margin:16px auto 0;text-align:center;" data-tina-field={tinaField(data, 'lead')}>{data.lead}</p>}
		{data.ctaLabel && (
			<div class="reveal d2" style="margin-top:30px;"><a href={data.ctaHref ?? '#'} class="btn btn-solid" data-tina-field={tinaField(data, 'ctaLabel')}>{data.ctaLabel} <span class="ar">→</span></a></div>
		)}
	</div>
</section>
