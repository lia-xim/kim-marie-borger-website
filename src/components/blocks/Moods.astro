---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
const moods = (data.moods ?? []).filter((m: unknown) => m !== null);
const delay = ['', ' d1', ' d2'];
const titleLines: string[] = (data.title ?? '').split('\n');
---
<section class="section bg-rose">
	<div class="wrap">
		{data.eyebrow && <p class="eyebrow reveal" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
		{data.title && <h2 class="display-m reveal" style="margin-top:14px;max-width:22ch;" data-tina-field={tinaField(data, 'title')}>
			{titleLines.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
		</h2>}
		<div class="moods">
			{moods.map((mood: any, i: number) => (
				<div class={`mood reveal${delay[i % 3]}`} data-tina-field={tinaField(mood)}>
					<h3>{mood.title}</h3>
					<ul>
						{(mood.items ?? []).filter((it: unknown) => it !== null).map((item: any) => (
							<li data-tina-field={tinaField(item)}>{item.title}{item.note && <small>{item.note}</small>}</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
