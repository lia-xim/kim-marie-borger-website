---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
const items = (data.items ?? []).filter((i: unknown) => i !== null);

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item: any) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer },
	})),
};
---
{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
<section class="section">
	<div class="wrap">
		{data.eyebrow && <p class="eyebrow c reveal" style="justify-content:center;display:flex;" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
		{data.title && <h2 class="display-m reveal" style="text-align:center;margin:14px auto 0;" data-tina-field={tinaField(data, 'title')}>{data.title}</h2>}
		<div class="faq reveal d1" style="margin-top:clamp(28px,3.5vw,44px);">
			{items.map((item: any) => (
				<details open={item.open || undefined} data-tina-field={tinaField(item)}>
					<summary>{item.question}<span class="fx" aria-hidden="true">+</span></summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
