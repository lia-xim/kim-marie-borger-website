---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';
import { normalizeHref } from '../lib/url';

interface Props {
	config?: CmsConfig | null;
	solid?: boolean;
}

const { config, solid = false } = Astro.props;
const brand = config?.brand ?? null;
const email = config?.contact?.email ?? 'kim-marie.borger@t-online.de';

const leistungen = [
	{ href: normalizeHref('/hochzeiten'), label: 'Hochzeitsmusik' },
	{ href: normalizeHref('/beerdigungen'), label: 'Trauermusik' },
	{ href: normalizeHref('/geburtstage'), label: 'Geburtstagsmusik' },
	{ href: normalizeHref('/taufen'), label: 'Taufmusik' },
	{ href: normalizeHref('/konzerte'), label: 'Konzerte & Events' },
	{ href: normalizeHref('/firmenfeiern'), label: 'Firmenevents' },
	{ href: normalizeHref('/anfragen'), label: 'Sonstiges' },
	{ href: normalizeHref('/unterricht'), label: 'Unterricht' },
];
---

<header class={`nav${solid ? ' solid' : ''}`} id="nav">
	<a class="brand" href="/">
		<span class="name" data-tina-field={brand ? tinaField(brand, 'name') : undefined}>{brand?.name ?? 'Kim Marie Borger'}</span>
		<span class="sub" data-tina-field={brand ? tinaField(brand, 'sub') : undefined}>{brand?.sub ?? 'Viola · Live'}</span>
	</a>
	<nav class="nav-links">
		<a href="/">Start</a>
		<span class="nav-item">
			<a href={normalizeHref('/leistungen')}>Leistungen <span class="caret" aria-hidden="true">▾</span></a>
			<span class="nav-drop">
				{leistungen.map((l) => <a href={l.href}>{l.label}</a>)}
			</span>
		</span>
		<a href={normalizeHref('/portfolio')}>Hörproben</a>
		<a href={normalizeHref('/ueber-mich')}>Über mich</a>
		<a href={normalizeHref('/ratgeber')}>Ratgeber</a>
		<a class="nav-cta" href={normalizeHref('/anfragen')} data-track-label="anfragen-header">Anfragen</a>
	</nav>
	<button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobileMenu"><span></span><span></span><span></span></button>
</header>
<nav class="mobile-menu" id="mobileMenu" aria-hidden="true" inert>
	<a href="/">Start</a>
	<div class="mm-group" id="mmGroup">
		<button class="mm-toggle" type="button" aria-expanded="false" aria-controls="mmSub">Leistungen
			<svg class="mm-caret" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
		</button>
		<div class="mm-sub" id="mmSub" aria-hidden="true" inert>
			<div class="mm-sub-in">
	{leistungen.filter((l) => l.href !== normalizeHref('/anfragen')).map((l) => <a href={l.href}>{l.label}</a>)}
			</div>
		</div>
	</div>
	<a href={normalizeHref('/portfolio')}>Hörproben</a>
	<a href={normalizeHref('/ueber-mich')}>Über mich</a>
	<a href={normalizeHref('/ratgeber')}>Ratgeber</a>
	<a href={normalizeHref('/anfragen')}>Anfragen</a>
	<a class="mm-mail" href={`mailto:${email}`} data-tina-field={config?.contact ? tinaField(config.contact, 'email') : undefined}>{email}</a>
</nav>
