---
import {
	getFeaturedTopicSeoPagesForService,
	getTopicSeoPage,
	serviceTopicsHubPath,
	topicPagePath,
} from '../lib/topic-seo';
import { getLocalService } from '../lib/local-seo';

interface Props {
	serviceSlug: string;
	currentTopicSlug?: string;
}

const { serviceSlug, currentTopicSlug } = Astro.props;
const service = getLocalService(serviceSlug);
const currentTopic = currentTopicSlug ? getTopicSeoPage(serviceSlug, currentTopicSlug) : undefined;
const sortedPages = getFeaturedTopicSeoPagesForService(serviceSlug);
const pages = currentTopic
	? [currentTopic, ...sortedPages.filter((page) => page.slug !== currentTopic.slug)].slice(0, 8)
	: sortedPages.slice(0, 10);
---

{service && pages.length > 0 && (
	<section class="section bg-paper2 local-seo-links topic-seo-links" aria-labelledby={`topic-links-${service.slug}`}>
		<div class="wrap">
			<div class="local-links-head reveal">
				<p class="eyebrow c">{service.parentLabel} Themen</p>
				<h2 id={`topic-links-${service.slug}`} class="display-m">
					{currentTopic ? `Verwandte Themen zu ${service.parentLabel}` : `${service.parentLabel}: zentrale Themen`}
				</h2>
				<p class="lead">
					{currentTopic
						? `Von dieser Detailfrage geht es weiter zur Hauptleistung, zu passenden Orten und zur Anfrage.`
						: `Die wichtigsten Themen ordnen typische Entscheidungen, bevor es zu den lokalen Angeboten geht.`}
				</p>
			</div>

			<div class="local-link-cloud reveal d2">
				{pages.map((page) => {
					const active = currentTopicSlug === page.slug;
					return (
						<a href={topicPagePath(page)} aria-current={active ? 'page' : undefined}>
							{page.linkLabel}
						</a>
					);
				})}
				<a class="local-hub-link" href={serviceTopicsHubPath(service.slug)}>
					Alle Themen zu {service.parentLabel}
				</a>
			</div>
		</div>
	</section>
)}
