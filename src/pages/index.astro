---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage } from '../lib/data';
import { islands } from '../lib/islands';
import { firstBlockImage, homeJsonLd } from '../lib/seo';

export const prerender = true;

const slug = 'home';
const page = await getPage(slug);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;
const title = data.seoTitle || config?.seo?.title || 'Kim Marie Borger · Viola';
const description = data.seoDescription || config?.seo?.description || '';
const heroImage = firstBlockImage(data);
const jsonLd = homeJsonLd(Astro.site ?? new URL(Astro.url.origin), title, description);
---

<Base
	title={title}
	description={description}
	image={heroImage ?? '/og-default.png'}
	imageAlt="Kim Marie Borger mit Viola"
	preloadImage={heroImage}
	bodyClass={data.bodyClass ?? undefined}
	structuredData={jsonLd}
>
	<TinaIsland name="page/" wrapper={islands.page.wrapper} params={{ slug }} primary>
		<PageBody data={data} includeHomepageAudio />
	</TinaIsland>
</Base>
