---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import LocalLinks from '../components/LocalLinks.astro';
import TopicLinks from '../components/TopicLinks.astro';
import { getConfig, getPage, listPages } from '../lib/data';
import { islands } from '../lib/islands';
import { firstBlockImage, subpageJsonLd } from '../lib/seo';
import { hasLocalService } from '../lib/local-seo';
import { hasTopicService } from '../lib/topic-seo';

export async function getStaticPaths() {
	const pages = await listPages();
	return pages
		.map((node) => node._sys.filename)
		.filter((slug) => slug !== 'home')
		.map((slug) => ({ params: { slug } }));
}

const slug = (Astro.params.slug ?? '').toString();
const page = await getPage(slug);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;
const breadcrumbName = (data.seoTitle || slug).split('—')[0].trim();
const jsonLd = subpageJsonLd(Astro.site ?? new URL(Astro.url.origin), slug, breadcrumbName, data.seoDescription ?? undefined);
---

<Base
	title={data.seoTitle || config?.seo?.title || 'Kim Marie Borger · Viola'}
	description={data.seoDescription || config?.seo?.description || ''}
	image={firstBlockImage(data)}
	bodyClass={data.bodyClass ?? undefined}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary>
		<PageBody data={data} />
	</TinaIsland>
	{hasTopicService(slug) && <TopicLinks serviceSlug={slug} />}
	{hasLocalService(slug) && <LocalLinks serviceSlug={slug} />}
</Base>
