---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import {
	getRatgeberPage,
	getRatgeberPages,
	ratgeberPageJsonLd,
	ratgeberPath,
} from '../../lib/ratgeber';

export const prerender = true;

export function getStaticPaths() {
	return getRatgeberPages().map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
}

const page = Astro.props.page ?? getRatgeberPage(String(Astro.params.slug ?? ''));
if (!page) return new Response('Not Found', { status: 404 });

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = ratgeberPageJsonLd(site, page);
---

<Base
	title={page.seoTitle}
	description={page.seoDescription}
	image={page.heroImage}
	preloadImage={page.heroImage}
	imageAlt={page.heroImageAlt}
	bodyClass="page-ratgeber page-ratgeber-detail"
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<main>
		<article>
			<header class="guide-hero" aria-labelledby="guide-title">
				<div class="guide-hero-media" aria-hidden="true">
					<Img src={page.heroImage} alt={page.heroImageAlt} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />
				</div>
				<div class="guide-hero-scrim"></div>
				<div class="wrap guide-hero-content">
					<a class="guide-back" href="/ratgeber/">Ratgeber</a>
					<p class="eyebrow light">{page.kicker}</p>
					<h1 id="guide-title" class="guide-title">{page.title}</h1>
					<p class="guide-lead">{page.lead}</p>
				</div>
			</header>

			<section class="section guide-article" aria-labelledby="guide-orientierung">
				<div class="wrap guide-article-grid">
					<aside class="guide-aside" aria-label="Kurzüberblick">
						<p class="ksmall">Suchintention</p>
						<p>{page.intent}</p>
						<ul>
							{page.keyPoints.map((point) => <li>{point}</li>)}
						</ul>
					</aside>

					<div class="guide-copy">
						<h2 id="guide-orientierung" class="display-s">Orientierung</h2>
						{page.sections.map((section) => (
							<section class="guide-copy-section">
								<h3>{section.title}</h3>
								{section.body.map((paragraph) => <p>{paragraph}</p>)}
							</section>
						))}
					</div>
				</div>
			</section>

			<section class="section bg-paper2 guide-next" aria-labelledby="guide-links">
				<div class="wrap guide-next-grid">
					<div>
						<p class="eyebrow">Weiter planen</p>
						<h2 id="guide-links" class="display-m">Passende Seiten auf der Website.</h2>
						<p class="lead">
							Diese Ratgeberseite ist mit den konkreten Leistungs- und Themenseiten
							verbunden, damit aus Orientierung eine praktische Anfrage werden kann.
						</p>
						<a class="btn btn-solid" href={page.nextStep.href}>{page.nextStep.label}</a>
					</div>
					<div class="guide-link-list">
						{page.internalLinks.map((link) => (
							<a href={link.href}>
								<span>{link.label}</span>
								{link.note && <small>{link.note}</small>}
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="section guide-faq" aria-labelledby="guide-faq-title">
				<div class="wrap guide-faq-grid">
					<div>
						<p class="eyebrow">Gut zu wissen</p>
						<h2 id="guide-faq-title" class="display-m">Häufige Fragen.</h2>
					</div>
					<div class="guide-faq-list">
						{page.faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<p>{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<nav class="section bg-olive guide-siblings" aria-label="Weitere Ratgeber">
				<div class="wrap">
					<p class="eyebrow light c">Weitere Ratgeber</p>
					<div class="guide-service-links guide-service-links-dark">
						{getRatgeberPages()
							.filter((item) => item.slug !== page.slug)
							.slice(0, 5)
							.map((item) => (
								<a href={ratgeberPath(item)}>{item.shortTitle}</a>
							))}
					</div>
				</div>
			</nav>
		</article>
	</main>
</Base>
