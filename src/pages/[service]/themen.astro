---
import Base from '../../layouts/Base.astro';
import {
	LOCAL_SERVICES,
	getLocalService,
	serviceLocationsHubPath,
} from '../../lib/local-seo';
import {
	getTopicSeoPagesForService,
	getTopicNavigationGroups,
	serviceTopicsHubPath,
	topicPagePath,
} from '../../lib/topic-seo';
import {
	getRatgeberPagesForService,
	ratgeberPath,
} from '../../lib/ratgeber';
import { canonicalUrl } from '../../lib/url';

export const prerender = true;

export function getStaticPaths() {
	return LOCAL_SERVICES
		.filter((service) => getTopicSeoPagesForService(service.slug).length > 0)
		.map((service) => ({
			params: { service: service.slug },
		}));
}

const serviceSlug = Astro.params.service?.toString() ?? '';
const service = getLocalService(serviceSlug);
const allTopics = service
	? getTopicSeoPagesForService(service.slug).sort((a, b) => a.label.localeCompare(b.label))
	: [];
if (!service || allTopics.length === 0) return new Response('Not Found', { status: 404 });

const topicGroups = getTopicNavigationGroups(service.slug);
const guidePages = getRatgeberPagesForService(service.slug);
const route = serviceTopicsHubPath(service.slug);
const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = canonicalUrl(site, route).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BreadcrumbList',
			'@id': `${pageUrl}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Start', item: site.href },
				{ '@type': 'ListItem', position: 2, name: service.parentLabel, item: canonicalUrl(site, `/${service.slug}/`).href },
				{ '@type': 'ListItem', position: 3, name: 'Themen', item: pageUrl },
			],
		},
		{
			'@type': 'CollectionPage',
			'@id': `${pageUrl}#collection`,
			name: `${service.parentLabel}: Fragen und Möglichkeiten`,
			description: `Übersicht zu Abläufen, Anlässen, Stücken, Besetzung und Buchung rund um ${service.parentLabel}.`,
			url: pageUrl,
			inLanguage: 'de',
			mainEntity: {
				'@type': 'ItemList',
				'@id': `${pageUrl}#items`,
				itemListElement: allTopics.map((page, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: page.linkLabel,
					url: canonicalUrl(site, topicPagePath(page)).href,
				})),
			},
		},
	],
};
---

<Base
	title={`${service.keyword}: Themen & Möglichkeiten | Kim Marie Borger`}
	description={`Alle Fragen und Formate zu ${service.parentLabel}: Abläufe, Stücke, Besetzung, Buchung und passende nächste Schritte.`}
	bodyClass="page-link-hub"
	structuredData={jsonLd}
>
	<main>
		<section class="section link-hub-hero" aria-labelledby="themen-title">
			<div class="wrap link-hub-hero-grid">
				<div>
					<p class="eyebrow">Themenübersicht</p>
					<h1 id="themen-title" class="display-l">{service.parentLabel}: Fragen und Möglichkeiten.</h1>
				</div>
				<div>
					<p class="lead">
						Wähle den Anlass oder die Planungsfrage, die gerade ansteht. Von dort geht es
						zu Ablauf, Stückauswahl, Besetzung und einer konkreten Anfrage.
					</p>
					<div class="link-hub-actions">
						<a class="btn" href={`/${service.slug}/`}>Zur Leistung</a>
						<a class="btn btn-ghost" href={serviceLocationsHubPath(service)}>Alle Orte</a>
					</div>
				</div>
			</div>
		</section>

		<section class="section bg-paper2 link-hub-list" aria-labelledby="themen-list">
			<div class="wrap">
				<div class="local-links-head">
					<p class="eyebrow c">Planung nach Anlass</p>
					<h2 id="themen-list" class="display-m">Schnell zur passenden Entscheidung.</h2>
					<p class="lead">
						Die Themen folgen typischen Entscheidungen – vom Ablauf über die Stückauswahl
						und Besetzung bis zur konkreten Anfrage.
					</p>
				</div>
				<div class="link-hub-group-grid">
					{topicGroups.map((group, index) => (
						<section class="link-hub-group" aria-labelledby={`${service.slug}-themen-${index}`}>
							<h3 id={`${service.slug}-themen-${index}`}>{group.title}</h3>
							<p>{group.description}</p>
							<div class="service-discovery-links">
								{group.pages.map((page) => (
									<a href={topicPagePath(page)}>{page.linkLabel}</a>
								))}
							</div>
						</section>
					))}
				</div>
			</div>
		</section>

		{guidePages.length > 0 && (
			<section class="section guide-topic-map" aria-labelledby="themen-ratgeber">
				<div class="wrap">
					<div class="local-links-head">
						<p class="eyebrow c">Ratgeber</p>
						<h2 id="themen-ratgeber" class="display-m">Wissen, wenn die Entscheidung noch reift.</h2>
						<p class="lead">
							Der Ratgeber bleibt ein dezenter Orientierungspfad und ersetzt nicht den
							direkten Weg zur Leistung oder Anfrage.
						</p>
					</div>
					<div class="guide-service-links">
						{guidePages.map((page) => (
							<a href={ratgeberPath(page)}>{page.shortTitle}</a>
						))}
						<a href="/ratgeber/">Alle Ratgeber</a>
					</div>
				</div>
			</section>
		)}
	</main>
</Base>
