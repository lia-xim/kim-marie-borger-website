---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../../components/islands/PageBody.astro';
import LocalLinks from '../../components/LocalLinks.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import { getConfig, getPage, getSeoPage } from '../../lib/data';
import { islands } from '../../lib/islands';
import { firstBlockImage } from '../../lib/seo';
import { getSeoPageOverride, type SeoPageKind, type SeoPageOverride } from '../../lib/seo-overrides';
import {
	buildLocalSeoPage,
	getLocalSeoPage,
	getLocalSeoPages,
	localSeoJsonLd,
} from '../../lib/local-seo';
import {
	buildTopicSeoPage,
	getTopicSeoPage,
	getTopicSeoPages,
	topicSeoJsonLd,
} from '../../lib/topic-seo';

export async function getStaticPaths() {
	const localPaths = getLocalSeoPages().map((page) => ({
		params: {
			service: page.service.slug,
			location: page.location.slug,
		},
		props: {
			pageKind: 'local',
			serviceSlug: page.service.slug,
			pageSlug: page.location.slug,
		},
	}));

	const topicPaths = getTopicSeoPages().map((page) => ({
		params: {
			service: page.serviceSlug,
			location: page.slug,
		},
		props: {
			pageKind: 'topic',
			serviceSlug: page.serviceSlug,
			pageSlug: page.slug,
		},
	}));

	return [...localPaths, ...topicPaths];
}

const pageKind = Astro.props.pageKind as SeoPageKind;
const serviceSlug = Astro.props.serviceSlug as string;
const pageSlug = Astro.props.pageSlug as string;
const localPage = pageKind === 'local' ? getLocalSeoPage(serviceSlug, pageSlug) : undefined;
const topicPage = pageKind === 'topic' ? getTopicSeoPage(serviceSlug, pageSlug) : undefined;
if (!localPage && !topicPage) return new Response('Not Found', { status: 404 });

const baseSlug = localPage?.service.baseSlug ?? topicPage?.baseSlug;
if (!baseSlug) return new Response('Not Found', { status: 404 });

const page = await getPage(baseSlug);
const baseData = page.data?.page;
if (!baseData) return new Response('Not Found', { status: 404 });

const seoPage = await getSeoPage(serviceSlug, pageSlug, { priority: 'primary' });
const override = (seoPage.data?.seoPage as unknown as SeoPageOverride | undefined)
	?? getSeoPageOverride(pageKind, serviceSlug, pageSlug);
const data = localPage
	? buildLocalSeoPage(localPage, baseData, override)
	: buildTopicSeoPage(topicPage!, baseData, override);
const config = (await getConfig()).data?.config ?? null;
const jsonLd = localPage
	? localSeoJsonLd(Astro.site ?? new URL(Astro.url.origin), localPage, override)
	: topicSeoJsonLd(Astro.site ?? new URL(Astro.url.origin), topicPage!, override);
---

<Base
	title={data.seoTitle || config?.seo?.title || 'Kim Marie Borger · Viola'}
	description={data.seoDescription || config?.seo?.description || ''}
	image={firstBlockImage(data)}
	imageAlt={data.seoTitle || config?.seo?.title || 'Kim Marie Borger · Viola'}
	bodyClass={data.bodyClass ?? undefined}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<TinaIsland
		name="seoPage/"
		wrapper={islands.seoPage.wrapper}
		params={{ pageKind, serviceSlug, pageSlug }}
		primary
	>
		<PageBody data={data} />
	</TinaIsland>
	{localPage && <TopicLinks serviceSlug={localPage.service.slug} />}
	{topicPage && <TopicLinks serviceSlug={topicPage.serviceSlug} currentTopicSlug={topicPage.slug} />}
	{localPage && <LocalLinks serviceSlug={localPage.service.slug} currentLocationSlug={localPage.location.slug} />}
	{topicPage && <LocalLinks serviceSlug={topicPage.serviceSlug} />}
</Base>
