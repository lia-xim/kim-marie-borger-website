---
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base title="Seite nicht gefunden — Kim Marie Borger · Viola" description="Diese Seite existiert nicht oder wurde verschoben." noindex>
	<main>
		<section class="section" style="min-height:60vh;display:flex;align-items:center;">
			<div class="wrap" style="text-align:center;">
				<p class="eyebrow c">404</p>
				<h1 class="display-l" style="margin-top:18px;">Diese Seite ist verklungen.</h1>
				<p class="lead" style="margin:18px auto 0;text-align:center;max-width:46ch;">Die gesuchte Seite gibt es nicht (mehr). Vielleicht findest du auf der Startseite, wonach du suchst.</p>
				<div style="margin-top:32px;">
					<a href="/" class="btn btn-solid">Zur Startseite <span class="ar">→</span></a>
				</div>
			</div>
		</section>
	</main>
</Base>
