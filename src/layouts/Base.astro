---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import { siteEntityJsonLd } from '../lib/schema';
import kmbScriptUrl from '../scripts/kmb.js?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	preloadImage?: string;
	bodyClass?: string;
	solidNav?: boolean;
	noindex?: boolean;
	structuredData?: object | object[];
}

const {
	title,
	description,
	image,
	imageAlt,
	preloadImage,
	bodyClass,
	solidNav = !preloadImage,
	noindex,
	structuredData,
} = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const site = Astro.site ?? new URL(Astro.url.origin);
const globalJsonLd = siteEntityJsonLd(site, config);
const structuredDataBlocks = Array.isArray(structuredData)
	? structuredData
	: structuredData
		? [structuredData]
		: [];
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={title} description={description} image={image} imageAlt={imageAlt} preloadImage={preloadImage} noindex={noindex} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(globalJsonLd)} />
		{structuredDataBlocks.map((block) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
		))}
	</head>
	<body class={bodyClass || undefined}>
		<TinaIsland name="global/" wrapper={islands.global.wrapper}>
			<Header config={config} solid={solidNav} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer/" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<script is:inline src={kmbScriptUrl}></script>
		<script is:inline>
			// Umami-Analytics (selbst gehostet, cookielos) -- nur fuer echte
			// Besuche: nicht im Tina-Editor-iframe, nicht in lokaler Entwicklung.
			if (window.self === window.top && !/^(localhost|127\.|192\.168\.)/.test(location.hostname)) {
				var u = document.createElement('script');
				u.defer = true;
				u.src = 'https://analytics.contextter.com/script.js';
				u.setAttribute('data-website-id', '374375a3-486e-4c83-97de-e05aa223c92d');
				document.head.appendChild(u);
			}
		</script>
	</body>
</html>
