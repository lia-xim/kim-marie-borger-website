---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import kmbScriptUrl from '../scripts/kmb.js?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	bodyClass?: string;
	noindex?: boolean;
}

const { title, description, image, imageAlt, bodyClass, noindex } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const site = Astro.site ?? new URL(Astro.url.origin);
const personId = new URL('/#person', site).href;

// Structured data: musician + website, fed from the editable global config.
const sameAs = [config?.footer?.instagram, config?.footer?.youtube].filter(Boolean);
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personId,
			name: config?.brand?.name ?? 'Kim Marie Borger',
			jobTitle: 'Bratschistin',
			hasOccupation: {
				'@type': 'Occupation',
				name: 'Bratschistin',
			},
			description: config?.seo?.description,
			email: config?.contact?.email ? `mailto:${config.contact.email}` : undefined,
			url: site.href,
			image: new URL(image ?? '/og-default.png', site).href,
			knowsLanguage: ['de'],
			contactPoint: config?.contact?.email ? {
				'@type': 'ContactPoint',
				email: config.contact.email,
				contactType: 'booking request',
				areaServed: 'DE',
				availableLanguage: ['de'],
			} : undefined,
			...(sameAs.length ? { sameAs } : {}),
			knowsAbout: ['Viola', 'Hochzeitsmusik', 'Trauermusik', 'Kammermusik', 'Musikunterricht'],
		},
		{
			'@type': 'WebSite',
			'@id': new URL('/#website', site).href,
			name: config?.seo?.title ?? 'Kim Marie Borger · Viola',
			url: site.href,
			inLanguage: 'de',
			publisher: { '@id': personId },
		},
	],
};
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class={bodyClass || undefined}>
		<TinaIsland name="global/" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer/" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		<script is:inline src={kmbScriptUrl}></script>
		<script is:inline>
			// Umami-Analytics (selbst gehostet, cookielos) — nur für echte
			// Besuche: nicht im Tina-Editor-iframe, nicht in lokaler Entwicklung.
			if (window.self === window.top && !/^(localhost|127\.|192\.168\.)/.test(location.hostname)) {
				var u = document.createElement('script');
				u.defer = true;
				u.src = 'https://analytics.contextter.com/script.js';
				u.setAttribute('data-website-id', '374375a3-486e-4c83-97de-e05aa223c92d');
				document.head.appendChild(u);
			}
		</script>
	</body>
</html>
